# Add noise, add pedestal, find trigger primitives (using AbsRunningSum TP Finder), and save them to an output TTree.

#include "SNAna.fcl"
#include "AbsRunningSum.fcl"
#include "trigprim.fcl"

BEGIN_PROLOG
trigprim_snana: {
   @table::standard_snana
   SaveNeighbourADCs:    false
   SaveTruth:            false
}

absrunningsumtppass1: 
{
  module_type: "AbsRunningSumTPFinder"
  InputTag:    "simwire"
  finderCol: 
  {
    tool_type: "AbsRunningSumTPFinderPass1"
    Threshold: 10
    UseSignalKill: true        
    SignalKillLookahead: 6
    SignalKillThreshold: 15
    SignalKillNContig:   10
  }
  finderInd: 
  {
    tool_type: "AbsRunningSumTPFinderPass1"
    Threshold: 10
    UseSignalKill: true        
    SignalKillLookahead: 6
    SignalKillThreshold: 15
    SignalKillNContig:   10
  }
}

END_PROLOG

#include "opticaldetectormodules_dune.fcl"
#include "detsim_1dsimulation_dune10kt_1x2x6.fcl"

process_name: PrimSim
services.TFileService: { fileName: "SNAna_refactored_plus_trigprim_multithreshold.root" }

physics: {
   producers: {
      simwire: {
         module_type: "SimWireDUNE"
         SimChannelLabel: "elecDrift"
         NoiseOn: true
         PedestalOn: true
         DistortOn: false
         SuppressOn: false
         KeepEmptyChannels: true
         AdcSimulator:      "adcsim_ideal"
         UseRawDigitInput: true
         RawDigitInputLabel: "daq"
      }

      ophit:              @local::dune35t_ophit

      # Include AbsRunningSum trigger primitive producers
      trigprimAbsRunningSum: @local::absrunningsumtppass1  # New producer for AbsRunningSum TPs
     
      rns:            { module_type: "RandomNumberSaver" }
   }

   analyzers: {
      # Create an SNAna for each trigger primitive finder.
      snanatrigprimAbsRunningSum: @local::trigprim_snana  # New analyzer for AbsRunningSum TPs

   }

   simulate: [rns, simwire, ophit,
              trigprimAbsRunningSum]
   ana     : [snanatrigprimAbsRunningSum]

   trigger_paths: [ simulate ]
   end_paths: [ ana ]
}

services.Geometry : @local::dune10kt_1x2x2_v4_refactored_geoApptainer



# Set the HitLabel for corresponding TriggerPrimitiveFinder
physics.analyzers.snanatrigprimAbsRunningSum.HitLabel: "trigprimAbsRunningSum"  # Add the HitLabel for AbsRunningSum TP

# Shut up the backtracker
services.message.destinations.LogStandardOut.categories.BackTracker.limit: 0
services.message.destinations.LogStandardError.categories.BackTracker.limit: 0

# Display all the INFO message for SNAna_module
services.message.destinations.LogStandardOut.categories.SNAna_module.limit:-1
